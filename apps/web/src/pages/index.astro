---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SearchBar } from '../components/islands/SearchBar';
import { translations, getLangFromUrl } from '../lib/i18n';

const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];
---

<BaseLayout 
  title={`${t.appName} | ${t.appSubtitle}`}
  description={t.heroSubtitle}
  lang={currentLang}
>
  <div class="flex flex-col items-center justify-center min-h-[70vh] text-center max-w-3xl mx-auto py-12">
    <!-- Hero Emblem -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold font-sans mb-6">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span>{t.heroTag}</span>
    </div>

    <!-- Title & Subtitle -->
    <h1 class="text-4xl sm:text-6xl font-bold font-sans tracking-tight text-base-content mb-4 leading-tight">
      {t.heroTitle}
    </h1>
    <p class="text-base sm:text-lg text-base-content/70 font-sans mb-10 max-w-xl mx-auto leading-relaxed">
      {t.heroSubtitle}
    </p>

    <!-- Large Search Bar Island -->
    <div id="main-search-container" class="w-full mb-8">
      <SearchBar client:load size="large" autoFocus={true} lang={currentLang} />
    </div>

    <!-- Quick Exploration Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-sans text-base-content/70 mt-2">
      <span class="font-bold text-base-content/50">{t.quickExamples}</span>
      <a href={`/search?q=إنما+الأعمال+بالنيات&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3">
        إنما الأعمال بالنيات
      </a>
      <a href={`/search?q=شروط+بيع+السلم&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3">
        شروط بيع السلم
      </a>
      <a href={`/search?q=صلاة+الوتر+في+السفر&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3">
        صلاة الوتر في السفر
      </a>
      <a href={`/search?q=طهارة+الماء+الراكد&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3">
        طهارة الماء الراكد
      </a>
    </div>

    <!-- Feature Grid Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full mt-16 pt-12 border-t border-base-200/70 text-start">
      <div class="p-4 rounded-2xl bg-base-100/70 border border-base-200">
        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold mb-2">١</div>
        <h4 class="font-bold text-sm text-base-content mb-1">{t.feature1Title}</h4>
        <p class="text-xs text-base-content/60 leading-relaxed">{t.feature1Desc}</p>
      </div>

      <div class="p-4 rounded-2xl bg-base-100/70 border border-base-200">
        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold mb-2">٢</div>
        <h4 class="font-bold text-sm text-base-content mb-1">{t.feature2Title}</h4>
        <p class="text-xs text-base-content/60 leading-relaxed">{t.feature2Desc}</p>
      </div>

      <div class="p-4 rounded-2xl bg-base-100/70 border border-base-200">
        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold mb-2">٣</div>
        <h4 class="font-bold text-sm text-base-content mb-1">{t.feature3Title}</h4>
        <p class="text-xs text-base-content/60 leading-relaxed">{t.feature3Desc}</p>
      </div>
    </div>
  </div>
</BaseLayout>

