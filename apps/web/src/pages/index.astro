---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SearchBar } from '../components/islands/SearchBar';
import { LanguageSwitcher } from '../components/islands/LanguageSwitcher';
import { ThemeSwitcher } from '../components/islands/ThemeSwitcher';
import { translations, getLangFromUrl } from '../lib/i18n';

const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];
const isAr = currentLang === 'ar';
---

<BaseLayout 
  title={`${t.appName} | ${t.appSubtitle}`}
  description={t.heroSubtitle}
  lang={currentLang}
>
  <div class="flex flex-col items-center justify-center min-h-[70vh] text-center max-w-4xl mx-auto py-8 sm:py-12">
    
    <!-- Top Preferences & Emblem Capsule -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/15 text-primary text-xs font-bold font-sans shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span>{t.heroTag}</span>
      </div>
      <div class="inline-flex items-center gap-1.5 bg-base-200/80 p-1 rounded-2xl border border-base-300 shadow-2xs backdrop-blur-xs">
        <ThemeSwitcher client:load currentLang={currentLang} compact={true} />
        <LanguageSwitcher client:load currentLang={currentLang} compact={true} />
      </div>
    </div>

    <!-- Hero Title & Subtitle -->
    <h1 class="text-4xl sm:text-6xl font-bold font-sans tracking-tight text-base-content mb-4 leading-tight">
      {t.heroTitle}
    </h1>
    <p class="text-base sm:text-lg text-base-content/80 font-sans mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed">
      {t.heroSubtitle}
    </p>

    <!-- Large Search Bar Island -->
    <div id="main-search-container" class="w-full mb-4">
      <SearchBar client:load size="large" autoFocus={true} lang={currentLang} />
    </div>

    <!-- Multilingual AI Search Guidance Note -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-base-200/70 border border-base-300 text-xs font-sans text-base-content/85 max-w-xl mb-6 leading-relaxed shadow-2xs">
      <span class="text-base flex-shrink-0">🌐</span>
      <span>{t.multilingualHint}</span>
    </div>

    <!-- Quick Exploration Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-sans text-base-content/80 mt-1">
      <span class="font-bold text-base-content/60">{t.quickExamples}</span>
      <a href={`/search?q=إنما+الأعمال+بالنيات&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3 font-medium">
        إنما الأعمال بالنيات
      </a>
      <a href={`/search?q=شروط+بيع+السلم&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3 font-medium">
        شروط بيع السلم
      </a>
      <a href={`/search?q=صلاة+الوتر+في+السفر&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3 font-medium">
        صلاة الوتر في السفر
      </a>
      <a href={`/search?q=طهارة+الماء+الراكد&lang=${currentLang}`} class="badge badge-lg badge-outline hover:badge-primary transition-colors py-3 font-medium">
        طهارة الماء الراكد
      </a>
    </div>

    <!-- SECTION 1: How to Use OpenBayan (3-Step Guided Workflow) -->
    <div class="w-full mt-20 pt-12 border-t border-base-300/80 text-start">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-bold font-sans mb-2.5">
          <span>🚀</span>
          <span>{isAr ? 'دليل الاستخدام السريع' : currentLang === 'id' ? 'Panduan Penggunaan Singkat' : 'Quick User Guide'}</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-sans text-base-content mb-2">
          {t.howToUseTitle}
        </h2>
        <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
          {t.howToUseSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Step 1 Card -->
        <div class="p-5 rounded-2xl bg-base-100 border border-base-300 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-primary/15 text-primary flex items-center justify-center font-bold text-sm">
                {isAr ? '١' : '1'}
              </span>
              <span class="text-xl group-hover:scale-110 transition-transform">🔍</span>
            </div>
            <h3 class="font-bold text-base text-base-content mb-2 font-sans">
              {t.step1Title}
            </h3>
            <p class="text-xs text-base-content/80 leading-relaxed font-sans">
              {t.step1Desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-base-200 text-[11px] text-primary font-bold font-sans flex items-center gap-1">
            <span>💡</span>
            <span>{isAr ? 'البحث اللفظي + الدلالي الذكي' : currentLang === 'id' ? 'Pencarian Semantik & Akar Kata' : 'Exact FTS5 + Semantic E5'}</span>
          </div>
        </div>

        <!-- Step 2 Card -->
        <div class="p-5 rounded-2xl bg-base-100 border border-base-300 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-primary/15 text-primary flex items-center justify-center font-bold text-sm">
                {isAr ? '٢' : '2'}
              </span>
              <span class="text-xl group-hover:scale-110 transition-transform">📋</span>
            </div>
            <h3 class="font-bold text-base text-base-content mb-2 font-sans">
              {t.step2Title}
            </h3>
            <p class="text-xs text-base-content/80 leading-relaxed font-sans">
              {t.step2Desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-base-200 text-[11px] text-primary font-bold font-sans flex items-center gap-1">
            <span>🛡️</span>
            <span>{isAr ? 'عزو كامل وتوثيق أكاديمي' : currentLang === 'id' ? 'Bebas Halusinasi & Rujukan Teruji' : 'Zero Hallucination Grounding'}</span>
          </div>
        </div>

        <!-- Step 3 Card -->
        <div class="p-5 rounded-2xl bg-base-100 border border-base-300 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-primary/15 text-primary flex items-center justify-center font-bold text-sm">
                {isAr ? '٣' : '3'}
              </span>
              <span class="text-xl group-hover:scale-110 transition-transform">📚</span>
            </div>
            <h3 class="font-bold text-base text-base-content mb-2 font-sans">
              {t.step3Title}
            </h3>
            <p class="text-xs text-base-content/80 leading-relaxed font-sans">
              {t.step3Desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-base-200 text-[11px] text-primary font-bold font-sans flex items-center gap-1">
            <span>🔄</span>
            <span>{isAr ? 'تصفح الفهارس والأبواب كاملة' : currentLang === 'id' ? 'Jelajahi Struktur Bab & Diskusi AI' : 'Iterative Thematic Exploration'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Why Use OpenBayan? (Comparative Decision Matrix) -->
    <div class="w-full mt-20 pt-12 border-t border-base-300/80 text-start">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary/15 text-secondary text-xs font-bold font-sans mb-2.5">
          <span>⚖️</span>
          <span>{isAr ? 'الميزة التنافسية والتوثيق' : currentLang === 'id' ? 'Perbandingan Nilai Tambah' : 'Comparative Value'}</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-sans text-base-content mb-2">
          {t.whyOpenBayanTitle}
        </h2>
        <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
          {t.whyOpenBayanSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
        
        <!-- Card 1: Using AI Directly (Left) -->
        <div class="p-5 rounded-2xl bg-base-100 border border-rose-500/30 dark:border-rose-500/20 shadow-2xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-lg bg-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-xs">
                ✕
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 font-sans">
                {isAr ? 'ذكاء اصطناعي مباشر' : currentLang === 'id' ? 'AI Langsung' : 'Direct AI Alone'}
              </span>
            </div>
            <h3 class="font-bold text-sm text-base-content mb-2 font-sans">
              {t.aiAloneTitle}
            </h3>
            <p class="text-xs text-base-content/80 leading-relaxed font-sans">
              {t.aiAloneDesc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-base-200 text-[11px] text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1.5">
            <span>⚠️</span>
            <span>{isAr ? 'مخاطر الهلوسة وغياب التوثيق' : currentLang === 'id' ? 'Risiko halusinasi rujukan & bias web' : 'Risk of hallucination & citation errors'}</span>
          </div>
        </div>

        <!-- Card 2: Using OpenBayan (Middle - Highlighted Solution) -->
        <div class="p-5 rounded-2xl bg-emerald-500/5 dark:bg-emerald-500/10 border-2 border-emerald-500/60 shadow-md md:-translate-y-1 relative overflow-hidden flex flex-col justify-between transition-transform">
          <div class="absolute top-0 end-0 bg-emerald-600 dark:bg-emerald-500 text-white dark:text-slate-950 text-[10px] font-bold px-3 py-0.5 rounded-bl-xl uppercase tracking-wider shadow-2xs">
            {isAr ? 'الخيار الأمثل' : currentLang === 'id' ? 'Solusi Terbaik' : 'Best Choice'}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-600 dark:bg-emerald-500 text-white dark:text-slate-950 flex items-center justify-center font-bold text-xs shadow-xs">
                ✓
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-sans">
                {isAr ? 'بيان + الذكاء الاصطناعي' : currentLang === 'id' ? 'OpenBayan + AI' : 'OpenBayan + AI'}
              </span>
            </div>
            <h3 class="font-bold text-sm text-base-content mb-2 font-sans">
              {t.openBayanAdvantageTitle}
            </h3>
            <p class="text-xs text-base-content/90 leading-relaxed font-sans font-medium">
              {t.openBayanAdvantageDesc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-emerald-500/30 text-[11px] text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1.5">
            <span>🏆</span>
            <span>{isAr ? 'توثيق معتمد بالجزء والصفحة + ذكاء فائق' : currentLang === 'id' ? 'Rujukan jilid & halaman pasti + AI cerdas' : 'Verified canonical citations + Confident AI'}</span>
          </div>
        </div>

        <!-- Card 3: Using Search Engines (Right) -->
        <div class="p-5 rounded-2xl bg-base-100 border border-amber-500/30 dark:border-amber-500/20 shadow-2xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
                !
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 font-sans">
                {isAr ? 'محركات بحث الويب' : currentLang === 'id' ? 'Mesin Pencari Umum' : 'Web Search Engine'}
              </span>
            </div>
            <h3 class="font-bold text-sm text-base-content mb-2 font-sans">
              {t.searchEngineTitle}
            </h3>
            <p class="text-xs text-base-content/80 leading-relaxed font-sans">
              {t.searchEngineDesc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-base-200 text-[11px] text-amber-600 dark:text-amber-400 font-semibold flex items-center gap-1.5">
            <span>⏱️</span>
            <span>{isAr ? 'تشتت النتائج وضياع الوقت' : currentLang === 'id' ? 'Harus menyaring manual satu per satu' : 'Manual sifting through unverified blogs'}</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</BaseLayout>
