---
import BaseLayout from '../layouts/BaseLayout.astro';
import PassageCard from '../components/astro/PassageCard.astro';
import { SearchBar } from '../components/islands/SearchBar';
import { INTERNAL_API_URL, type SearchResponse } from '../lib/api';
import { translations, getLangFromUrl } from '../lib/i18n';

// Parse query params
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const query = Astro.url.searchParams.get('q') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const limit = 15;
const mode = (Astro.url.searchParams.get('mode') || 'hybrid') as 'hybrid' | 'fts' | 'vector';

let searchData: SearchResponse | null = null;
let error: string | null = null;

if (query.trim()) {
  try {
    const fetchUrl = `${INTERNAL_API_URL}/search?q=${encodeURIComponent(query.trim())}&page=${page}&limit=${limit}&mode=${mode}&merge_siblings=true`;
    const res = await fetch(fetchUrl);
    if (res.ok) {
      searchData = await res.json();
    } else {
      error = `HTTP Error ${res.status}`;
    }
  } catch (err: any) {
    error = err?.message || 'Connection Error';
  }
}

const totalPages = searchData ? Math.ceil(searchData.total_hits / limit) : 0;
const pageTitle = query ? `${t.resultsFor} "${query}" | ${t.appName}` : `${t.searchBtn} | ${t.appName}`;

// Extract unique books in results for the outline
const uniqueBooks = searchData 
  ? Array.from(new Set(searchData.results.map(r => r.book_name)))
  : [];

const currentSearchUrl = Astro.url.href;
---

<BaseLayout title={pageTitle} lang={currentLang}>
  <div class="space-y-6">
    <!-- Top Search Header -->
    <div class="py-2 max-w-4xl mx-auto">
      <SearchBar 
        client:load 
        initialQuery={query} 
        initialMode={mode}
        size="normal"
        lang={currentLang}
      />
    </div>

    <!-- Error Banner if API failed -->
    {error && (
      <div class="alert alert-error shadow-sm font-sans my-4 max-w-4xl mx-auto">
        <span>{error}</span>
      </div>
    )}

    <!-- Search Results Header & Stats -->
    {searchData && (
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-sans text-base-content/70 pb-3 border-b border-base-200">
        <div>
          <span>{t.resultsFor} <strong class="text-base-content text-sm">"{query}"</strong></span>
          <span class="mx-2">({searchData.total_hits} {t.resultsCount} {searchData.took_ms} ms)</span>
        </div>

        <div class="text-[11px] font-mono opacity-60">
          {t.pageOf} {page} / {totalPages || 1}
        </div>
      </div>
    )}

    <!-- Main Grid: 8 Cols (Results) + 4 Cols (Sticky Telemetry & AI Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Main Results Column (8 cols) -->
      <section class="lg:col-span-8 space-y-4">
        {searchData && searchData.results.length > 0 && (
          <div class="space-y-4">
            {searchData.results.map((item, idx) => (
              <PassageCard 
                chunk={item} 
                rankIndex={(page - 1) * limit + idx + 1} 
                lang={currentLang}
                searchQuery={query}
              />
            ))}
          </div>
        )}

        <!-- Empty State -->
        {searchData && searchData.results.length === 0 && (
          <div class="text-center py-16 bg-base-100/60 rounded-3xl border border-dashed border-base-300 p-8 my-6">
            <div class="w-12 h-12 rounded-full bg-base-200 text-base-content/40 flex items-center justify-center mx-auto mb-3 text-xl">
              🔍
            </div>
            <h3 class="text-base font-bold text-base-content mb-1 font-sans">{t.noResultsTitle}</h3>
            <p class="text-xs text-base-content/60 font-sans max-w-sm mx-auto">
              {t.noResultsDesc}
            </p>
          </div>
        )}

        <!-- SSR Pagination Controls -->
        {totalPages > 1 && (
          <div class="flex items-center justify-center gap-2 pt-8 pb-12 font-sans">
            {page > 1 ? (
              <a
                href={`/search?q=${encodeURIComponent(query)}&mode=${mode}&page=${page - 1}&lang=${currentLang}`}
                class="btn btn-sm btn-outline btn-neutral"
              >
                {t.prevPage}
              </a>
            ) : (
              <button disabled class="btn btn-sm btn-disabled opacity-40">
                {t.prevPage}
              </button>
            )}

            <span class="text-xs font-bold px-3">
              {page} / {totalPages}
            </span>

            {page < totalPages ? (
              <a
                href={`/search?q=${encodeURIComponent(query)}&mode=${mode}&page=${page + 1}&lang=${currentLang}`}
                class="btn btn-sm btn-outline btn-neutral"
              >
                {t.nextPage}
              </a>
            ) : (
              <button disabled class="btn btn-sm btn-disabled opacity-40">
                {t.nextPage}
              </button>
            )}
          </div>
        )}
      </section>

      <!-- Sticky Sidebar Column (4 cols) -->
      <aside class="lg:col-span-4 space-y-5 font-sans">
        <div class="sticky top-20 space-y-5">
          
          <!-- Performance Telemetry Box -->
          {searchData && (
            <div class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-xs space-y-3 text-xs">
              <div class="flex items-center justify-between pb-2 border-b border-base-200/60 font-bold text-base-content/80">
                <span>{t.retrievalTelemetry}</span>
                <span class="font-mono text-emerald-700 font-bold">{searchData.took_ms} ms</span>
              </div>

              <div class="space-y-2 text-base-content/70">
                <div class="flex justify-between">
                  <span class="text-base-content/50">{t.retrievalMode}</span>
                  <span class="font-bold text-emerald-800 dark:text-emerald-400">
                    {mode === 'hybrid' ? t.modeHybrid : mode === 'fts' ? t.modeFts : t.modeVector}
                  </span>
                </div>
                <div class="flex justify-between">
                  <span class="text-base-content/50">Database Engine:</span>
                  <span class="font-mono">SQLite FTS5 + ONNX</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-base-content/50">Dense Vector Dim:</span>
                  <span class="font-mono text-emerald-800 font-semibold">768-dim</span>
                </div>
              </div>
            </div>
          )}

          <!-- AI PAGE URL EXPLORER CARD -->
          {searchData && searchData.results.length > 0 && (
            <div class="bg-gradient-to-br from-stone-900 to-slate-950 text-white rounded-2xl p-5 shadow-sm border border-stone-800 space-y-3 text-xs">
              <div class="flex items-center gap-2 font-bold text-emerald-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>{t.exploreWithAI}</span>
              </div>
              
              <p class="text-stone-300 leading-relaxed text-[11px]">
                {t.exploreWithAIDesc}
              </p>

              <!-- URL & Copy Button -->
              <div class="space-y-2 pt-1">
                <input
                  type="text"
                  readonly
                  value={currentSearchUrl}
                  class="w-full bg-black/50 border border-stone-700 rounded-lg px-2.5 py-1.5 font-mono text-[10px] text-emerald-300 select-all"
                />

                <button
                  type="button"
                  id="copy-page-url-btn"
                  class="w-full btn btn-sm bg-emerald-700 hover:bg-emerald-800 text-white font-bold border-0 gap-1.5 text-xs"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span>{t.copyPageUrlForAI}</span>
                </button>
              </div>
            </div>
          )}

          <!-- Books in Results Outline -->
          {uniqueBooks.length > 0 && (
            <div class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-xs space-y-2.5 text-xs">
              <div class="font-bold text-base-content/80 pb-2 border-b border-base-200/60">
                {t.thematicOutline} ({uniqueBooks.length})
              </div>
              <ul class="space-y-1.5 text-base-content/70">
                {uniqueBooks.map((book) => (
                  <li class="flex items-center gap-1.5 truncate">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 shrink-0"></span>
                    <span class="truncate">{book}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </div>
      </aside>

    </div>
  </div>

  <!-- Client Script for Copy Page URL Button -->
  <script>
    const btn = document.getElementById('copy-page-url-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const queryUrl = window.location.href;
        const prompt = `Please analyze and synthesize the classical Islamic corpus search results available at this live URL:\n${queryUrl}\n\nTask: Explore the primary source passages on this page, evaluate the key definitions and rulings, and summarize the consensus across Sunni schools.`;
        navigator.clipboard.writeText(prompt);

        const toastEl = document.getElementById('global-toast');
        const toastText = document.getElementById('global-toast-text');
        if (toastEl && toastText) {
          toastText.textContent = 'Page AI prompt copied!';
          toastEl.classList.remove('hidden');
          setTimeout(() => toastEl.classList.add('hidden'), 3000);
        }
      });
    }
  </script>
</BaseLayout>
