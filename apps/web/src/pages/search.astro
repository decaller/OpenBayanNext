---
import BaseLayout from '../layouts/BaseLayout.astro';
import PassageCard from '../components/astro/PassageCard.astro';
import { SearchBar } from '../components/islands/SearchBar';
import { SearchControls } from '../components/islands/SearchControls';
import { getApiUrl, type SearchResponse } from '../lib/api';
import { translations, getLangFromUrl, formatAllSearchResultsPrompt } from '../lib/i18n';
import { clusterSearchResults } from '../lib/thematic_clusterer';
import { createFacetUrl } from '../lib/url';

// Parse query params
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const query = Astro.url.searchParams.get('q') || '';
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const page = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const rawLimit = parseInt(Astro.url.searchParams.get('limit') || '15', 10);
const limit = isNaN(rawLimit) || rawLimit < 5 || rawLimit > 60 ? 15 : rawLimit;
const mode = (Astro.url.searchParams.get('mode') || 'hybrid') as 'hybrid' | 'fts' | 'vector';
const category = Astro.url.searchParams.get('category') || null;
const era = Astro.url.searchParams.get('era') || null;
const tradition = Astro.url.searchParams.get('tradition') || null;

let searchData: SearchResponse | null = null;
let error: string | null = null;

if (query.trim()) {
  try {
    const params = new URLSearchParams({
      q: query.trim(),
      page: page.toString(),
      limit: limit.toString(),
      mode: mode,
      merge_siblings: 'true'
    });
    if (category) params.set('category', category);
    if (era) params.set('era', era);
    if (tradition) params.set('tradition', tradition);

    const apiUrl = getApiUrl(true);
    const fetchUrl = `${apiUrl}/search?${params.toString()}`;
    const res = await fetch(fetchUrl);
    if (res.ok) {
      searchData = await res.json();
    } else {
      error = `HTTP Error ${res.status}`;
    }
  } catch (err: any) {
    error = err?.message || 'Connection Error';
  }
}

const pageTitle = query ? `${t.resultsFor} "${query}" | ${t.appName}` : `${t.searchBtn} | ${t.appName}`;

// Build dynamic content-driven thematic clusters with query sentence accuracy
const clusters = searchData 
  ? clusterSearchResults(searchData.results, query, currentLang) 
  : [];

// Pre-serialize full results for AI prompt
const allResultsAIPrompt = searchData 
  ? formatAllSearchResultsPrompt(searchData.results, query, currentLang)
  : '';

// Category filter items
const categoryOptions = [
  { id: null, label: t.allCategories },
  { id: 'شروح الحديث', label: 'شروح الحديث' },
  { id: 'كتب السنة', label: 'كتب السنة' },
  { id: 'التفسير', label: 'التفسير' },
  { id: 'الفقه الشافعي', label: 'الفقه الشافعي' },
  { id: 'الفقه المالكي', label: 'الفقه المالكي' },
  { id: 'العقيدة', label: 'العقيدة' },
];

const eraOptions = [
  { id: null, label: t.allEras },
  { id: 'early', label: t.eraEarly },
  { id: 'classical', label: t.eraClassical },
  { id: 'late', label: t.eraLate },
];

const traditionOptions = [
  { id: null, label: t.allTraditions },
  { id: 'classical_jumhur', label: t.traditionClassicalJumhur },
  { id: 'athari_salafi', label: t.traditionAthariSalafi },
];

const hasActiveFilters = Boolean(category || era || tradition);
---

<BaseLayout title={pageTitle} lang={currentLang}>
  <div class="space-y-6">
    <!-- Top Search Header -->
    <div id="main-search-container" class="py-2 max-w-4xl mx-auto">
      <SearchBar 
        client:load 
        initialQuery={query} 
        initialMode={mode}
        size="normal"
        lang={currentLang}
      />
    </div>

    <!-- Error Banner if API failed -->
    {error && (
      <div class="alert alert-error shadow-sm font-sans my-4 max-w-4xl mx-auto">
        <span>{error}</span>
      </div>
    )}

    <!-- Mobile Quick Navigation Bar (< 1024px) -->
    {query && searchData && searchData.results.length > 0 && (
      <div class="lg:hidden flex items-center justify-between gap-2 p-3 bg-base-100 border border-base-200 rounded-2xl shadow-xs font-sans text-xs">
        <span class="font-bold text-base-content/80 truncate">
          {searchData.results.length} {t.passages} ({clusters.length} {t.sectionsCount})
        </span>
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <a href="#sidebar-card-facets" class="btn btn-xs btn-outline btn-primary gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>{currentLang === 'en' ? 'Filters' : currentLang === 'id' ? 'Filter' : 'المرشحات'}</span>
          </a>
          <a href="#sidebar-controls-section" class="btn btn-xs btn-ghost text-base-content/70">
            <span>⚙️ {currentLang === 'en' ? 'Settings' : currentLang === 'id' ? 'Pengaturan' : 'العرض'}</span>
          </a>
        </div>
      </div>
    )}

    <!-- Main Grid: 8 Cols (Thematic Groups) + 4 Cols (Sticky Floating Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative">
      
      <!-- Main Results Column (8 cols): Thematic Structured Groups -->
      <section id="search-results-container" class="lg:col-span-8 space-y-8 depth-level-1">
        
        <!-- ======================================================== -->
        <!-- SCRIPTURE CITATION DIRECT INTERCEPTOR PINNED CARD -->
        <!-- ======================================================== -->
        {searchData?.pinned_citation && (
          <div class="bg-neutral text-neutral-content p-5 rounded-2xl shadow-md border border-neutral-content/20 font-sans space-y-3">
            <div class="flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <span class="badge badge-warning font-bold text-xs">
                  {t.scriptureCitationPinned.split(':')[0]}
                </span>
                <span class="font-bold text-neutral-content">
                  {searchData.pinned_citation.citation.display_title}
                </span>
              </div>
              <span class="text-neutral-content/80 font-mono text-[11px]">
                {searchData.pinned_citation.book_name} ({searchData.pinned_citation.volume_page})
              </span>
            </div>

            <div class="arabic-matn text-neutral-content text-base leading-loose p-3 bg-black/20 rounded-xl border border-neutral-content/15" dir="rtl">
              {searchData.pinned_citation.raw_text.slice(0, 380)}...
            </div>

            <div class="flex items-center justify-between pt-1 text-[11px] text-neutral-content/80">
              <span class="truncate">
                {searchData.pinned_citation.breadcrumb}
              </span>
              <button
                type="button"
                class="btn btn-xs btn-primary font-bold"
                data-open-drawer
                data-book-id={searchData.pinned_citation.book_id}
                data-chunk-id={searchData.pinned_citation.chunk_id}
                data-section-title={searchData.pinned_citation.section_title}
                data-breadcrumb={searchData.pinned_citation.breadcrumb}
              >
                {t.exploreInSidebar}
              </button>
            </div>
          </div>
        )}

        <!-- Thematic Groups -->
        {clusters.map((cluster) => {
          // Limit every thematic cluster to top 5 results on the page
          const topResults = cluster.results.slice(0, 5);
          const themeQuery = cluster.rawTopic || cluster.title;
          const themeQueryUrl = createFacetUrl(Astro.url, { q: themeQuery });

          return (
            <section id={cluster.id} class="space-y-4 scroll-mt-24">
              <!-- Thematic Group Header Banner (Responsive for 768px tablet) -->
              <div class="bg-base-100 border-s-4 border-primary p-5 rounded-2xl border border-base-200 shadow-xs font-sans space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5">
                    <span class="badge badge-neutral font-bold text-xs">
                      {cluster.clusterIndex}
                    </span>
                    <h3 class="text-base sm:text-lg font-bold text-base-content tracking-tight">
                      {cluster.title}
                    </h3>
                  </div>

                  <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
                    <!-- Thematic Query Sentence Accuracy Badge -->
                    <span 
                      class="badge badge-sm badge-outline badge-primary font-mono font-bold text-[11px] gap-1 flex-shrink-0"
                      title={`${t.matchAccuracy}: ${cluster.accuracy_percentage}%`}
                    >
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>{cluster.accuracy_percentage}%</span>
                    </span>

                    <!-- Real total passage count found under this theme -->
                    <span class="badge badge-sm badge-ghost font-mono flex-shrink-0" title={`${cluster.doc_count} passages found in this theme`}>
                      {cluster.doc_count} {t.passages}
                      {cluster.doc_count > 5 && (
                        <span class="text-[10px] text-base-content/50 ms-1">
                          ({currentLang === 'en' ? 'top 5' : currentLang === 'id' ? '5 teratas' : '٥ مختارة'})
                        </span>
                      )}
                    </span>
                    
                    <!-- Search This Topic Button in Header -->
                    <a
                      href={themeQueryUrl}
                      class="btn btn-xs btn-outline btn-primary font-bold gap-1 transition-all rounded-lg flex-shrink-0"
                      title={t.searchThisTheme}
                    >
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                      <span>{t.searchThisTheme} ↗</span>
                    </a>
                  </div>
                </div>

                <p class="text-xs text-base-content/70 leading-relaxed">
                  {cluster.summary}
                </p>

                <!-- Dominant Roots & Primary Sources Bar -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-2.5 border-t border-base-200/60 text-[11px] text-base-content/60">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="font-bold text-base-content/70">{t.dominantRoots}</span>
                    <div class="flex gap-1">
                      {cluster.dominant_roots.map(r => (
                        <span class="badge badge-xs badge-outline font-mono font-bold text-primary">
                          {r}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="flex items-center gap-1">
                    <span class="font-bold text-base-content/70">{t.primarySources}</span>
                    <span>{cluster.primary_sources.join(' • ')}</span>
                  </div>
                </div>
              </div>

              <!-- Top 5 Passages in this Thematic Cluster -->
              <div class="space-y-4">
                {topResults.map((item, idx) => (
                  <PassageCard 
                    chunk={item} 
                    rankIndex={idx + 1} 
                    lang={currentLang}
                    searchQuery={query}
                  />
                ))}
              </div>
            </section>
          );
        })}

        <!-- Pagination Controls -->
        {searchData && searchData.results.length > 0 && (
          <div class="flex items-center justify-between gap-4 p-4 bg-base-100 border border-base-200 rounded-2xl shadow-xs font-sans text-xs">
            {page > 1 ? (
              <a 
                href={createFacetUrl(Astro.url, { page: (page - 1).toString() })} 
                class="btn btn-sm btn-outline btn-primary gap-1.5"
              >
                <span>← {currentLang === 'en' ? 'Previous' : currentLang === 'id' ? 'Sebelumnya' : 'السابق'}</span>
              </a>
            ) : (
              <div />
            )}
            
            <span class="text-base-content/70 font-bold">
              {currentLang === 'en' ? `Page ${page}` : currentLang === 'id' ? `Halaman ${page}` : `الصفحة ${page}`}
            </span>

            {searchData.results.length >= limit ? (
              <a 
                href={createFacetUrl(Astro.url, { page: (page + 1).toString() })} 
                class="btn btn-sm btn-primary gap-1.5 font-bold"
              >
                <span>{currentLang === 'en' ? 'Next Page' : currentLang === 'id' ? 'Selanjutnya' : 'التالي'} →</span>
              </a>
            ) : (
              <div />
            )}
          </div>
        )}

        <!-- Actionable Empty State with Recovery Buttons -->
        {searchData && searchData.results.length === 0 && !searchData.pinned_citation && (
          <div class="text-center py-16 bg-base-100 rounded-3xl border border-dashed border-base-300 p-8 my-6 space-y-4">
            <div class="w-12 h-12 rounded-full bg-base-200 text-base-content/40 flex items-center justify-center mx-auto text-xl">
              🔍
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-base-content font-sans">{t.noResultsTitle}</h3>
              <p class="text-xs text-base-content/60 font-sans max-w-sm mx-auto">
                {t.noResultsDesc}
              </p>
            </div>

            <!-- Recovery Action CTAs -->
            <div class="flex flex-wrap items-center justify-center gap-2 pt-2 font-sans">
              {hasActiveFilters && (
                <a
                  href={`/search?q=${encodeURIComponent(query)}&lang=${currentLang}`}
                  class="btn btn-sm btn-primary font-bold gap-1.5"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>{currentLang === 'en' ? 'Reset Filters' : currentLang === 'id' ? 'Reset Filter' : 'إعادة تعيين المرشحات'}</span>
                </a>
              )}

              {mode !== 'vector' && (
                <a
                  href={`/search?q=${encodeURIComponent(query)}&mode=vector&lang=${currentLang}`}
                  class="btn btn-sm btn-outline btn-primary font-bold gap-1.5"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>{currentLang === 'en' ? 'Try Semantic AI Search' : currentLang === 'id' ? 'Coba Pencarian Semantik AI' : 'البحث في النمط المعنوي (الذكاء الاصطناعي)'}</span>
                </a>
              )}
            </div>
          </div>
        )}
      </section>

      <!-- Sticky Floating Sidebar Column (4 cols) -->
      <aside class="lg:col-span-4 floating-sidebar space-y-4 font-sans max-h-[calc(100vh-6.5rem)] overflow-y-auto pr-1">
        <div class="space-y-4">
          
          <!-- ======================================================== -->
          <!-- 1. COLLAPSIBLE FACET FILTERS CARD (Default Closed)       -->
          <!-- ======================================================== -->
          {query && (
            <div class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-sm space-y-3 font-sans text-xs transition-all" id="sidebar-card-facets">
              <button
                type="button"
                data-toggle-collapse="facets"
                class="flex items-center justify-between w-full font-bold text-base-content hover:text-primary transition-colors text-start focus:outline-none"
                title="Toggle Discipline & Tradition Filters"
              >
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                  </svg>
                  <span>{t.filterByDiscipline.replace(':', '')}</span>
                  {hasActiveFilters && (
                    <span class="badge badge-xs badge-primary font-mono font-bold">1+</span>
                  )}
                </div>

                <div class="flex items-center gap-1.5">
                  {hasActiveFilters && (
                    <a
                      href={createFacetUrl(Astro.url, { category: null, era: null, tradition: null })}
                      class="text-[10px] text-error hover:underline font-bold me-1"
                      title="Reset all filters"
                      onClick={(e) => e.stopPropagation()}
                    >
                      {currentLang === 'en' ? 'Reset' : currentLang === 'id' ? 'Reset' : 'إلغاء'}
                    </a>
                  )}
                  <span class="w-5 h-5 flex items-center justify-center rounded-md bg-base-200 text-base-content/60 transition-transform duration-200 chevron-icon">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Collapsible Body (Default Hidden) -->
              <div id="card-body-facets" class="space-y-3 pt-2 border-t border-base-200/60 hidden">
                <!-- Section A: Discipline / Category Facets -->
                <div class="space-y-1.5">
                  <span class="font-bold text-[11px] text-base-content/60 block">{t.filterByDiscipline}</span>
                  <div class="flex flex-wrap gap-1">
                    {categoryOptions.map((cat) => {
                      const isSelected = (cat.id === null && !category) || category === cat.id;
                      const facetUrl = createFacetUrl(Astro.url, { category: cat.id });
                      return (
                        <a
                          href={facetUrl}
                          class={`badge badge-sm rounded-lg transition-all text-[11px] ${
                            isSelected
                              ? 'badge-primary font-bold shadow-xs'
                              : 'bg-base-200/80 text-base-content/70 hover:bg-base-200 hover:text-base-content border-0'
                          }`}
                        >
                          {cat.label}
                        </a>
                      );
                    })}
                  </div>
                </div>

                <!-- Section B: Historical Era Facets -->
                <div class="space-y-1.5 pt-1.5 border-t border-base-200/50">
                  <span class="font-bold text-[11px] text-base-content/60 block">{t.filterByEra}</span>
                  <div class="flex flex-wrap gap-1">
                    {eraOptions.map((e) => {
                      const isSelected = (e.id === null && !era) || era === e.id;
                      const facetUrl = createFacetUrl(Astro.url, { era: e.id });
                      return (
                        <a
                          href={facetUrl}
                          class={`badge badge-xs transition-all ${
                            isSelected 
                              ? 'badge-neutral font-bold' 
                              : 'badge-ghost text-base-content/60 hover:badge-outline'
                          }`}
                        >
                          {e.label}
                        </a>
                      );
                    })}
                  </div>
                </div>

                <!-- Section C: Theological & Fiqh Tradition Facets -->
                <div class="space-y-1.5 pt-1.5 border-t border-base-200/50">
                  <span class="font-bold text-[11px] text-base-content/60 block">{t.filterByTradition}</span>
                  <div class="flex flex-wrap gap-1">
                    {traditionOptions.map((tr) => {
                      const isSelected = (tr.id === null && !tradition) || tradition === tr.id;
                      const facetUrl = createFacetUrl(Astro.url, { tradition: tr.id });
                      return (
                        <a
                          href={facetUrl}
                          class={`badge badge-xs transition-all ${
                            isSelected 
                              ? 'badge-primary font-bold' 
                              : 'badge-ghost text-base-content/60 hover:badge-outline'
                          }`}
                        >
                          {tr.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          )}
          
          <!-- ======================================================== -->
          <!-- 2. COLLAPSIBLE THEMATIC STRUCTURE CARD (Default Open)    -->
          <!-- ======================================================== -->
          {clusters.length > 0 && (
            <div class="bg-base-100 border border-base-200 rounded-2xl p-4 shadow-sm space-y-3 font-sans text-xs transition-all" id="sidebar-card-thematic">
              <button
                type="button"
                data-toggle-collapse="thematic"
                class="flex items-center justify-between w-full font-bold text-base-content hover:text-primary transition-colors text-start focus:outline-none"
                title="Toggle Thematic Structure"
              >
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <span>{t.thematicStructure}</span>
                </div>
                
                <div class="flex items-center gap-1.5">
                  <span class="badge badge-xs badge-neutral font-mono">{clusters.length} {t.sectionsCount}</span>
                  <span class="w-5 h-5 flex items-center justify-center rounded-md bg-base-200 text-base-content/60 transition-transform duration-200 chevron-icon rotate-180">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Collapsible Body -->
              <div id="card-body-thematic" class="space-y-3 pt-2 border-t border-base-200/60">
                <!-- Scrollable Thematic Navigation List (Max-height 52) -->
                <div class="space-y-1.5 max-h-52 overflow-y-auto pr-1">
                  {clusters.map((cl) => (
                    <a
                      href={`#${cl.id}`}
                      data-smooth-scroll
                      class="block p-3 rounded-xl border border-base-200/80 hover:border-primary hover:bg-primary/5 transition-all text-xs group"
                    >
                      <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-base-content group-hover:text-primary">
                          {cl.title}
                        </span>
                        <div class="flex items-center gap-1">
                          <!-- Navigation Item Accuracy Badge -->
                          <span class="badge badge-xs badge-outline badge-primary font-mono font-bold" title={t.matchAccuracy}>
                            {cl.accuracy_percentage}%
                          </span>
                          <span class="badge badge-xs badge-ghost font-mono" title={`${cl.doc_count} passages found`}>
                            {cl.doc_count}
                          </span>
                        </div>
                      </div>
                      <p class="text-[11px] text-base-content/60 truncate">
                        {cl.summary}
                      </p>
                    </a>
                  ))}
                </div>

                <!-- Telemetry Metrics inside Sidebar -->
                {searchData && (
                  <div class="pt-3 border-t border-base-200/60 space-y-1.5 text-xs text-base-content/70">
                    <div class="flex justify-between">
                      <span class="text-base-content/50">{t.retrievalMode}</span>
                      <span class="font-bold text-primary">
                        {mode === 'hybrid' ? t.modeHybrid : mode === 'fts' ? t.modeFts : t.modeVector}
                      </span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-base-content/50">{t.tookTime}</span>
                      <span class="font-mono text-primary font-bold">{searchData.took_ms} ms</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-base-content/50">{t.engine}</span>
                      <span class="font-mono">SQLite FTS5 + ONNX</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- ======================================================== -->
          <!-- 3. COLLAPSIBLE AI GROUNDING CARD (Theme-Adaptive)       -->
          <!-- ======================================================== -->
          {searchData && searchData.results.length > 0 && (
            <div class="bg-base-100 text-base-content rounded-2xl p-4 shadow-sm border border-base-200 space-y-3 font-sans text-xs transition-all" id="sidebar-card-ai">
              <button
                type="button"
                data-toggle-collapse="ai"
                class="flex items-center justify-between w-full font-bold text-primary hover:text-primary/80 transition-colors text-start focus:outline-none"
                title="Toggle AI Grounding Tools"
              >
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>{t.exploreWithAI}</span>
                </div>

                <div class="flex items-center gap-1.5">
                  <span class="badge badge-xs badge-neutral font-mono">{searchData.results.length} {t.passages}</span>
                  <span class="w-5 h-5 flex items-center justify-center rounded-md bg-base-200 text-base-content/60 transition-transform duration-200 chevron-icon rotate-180">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Collapsible Body -->
              <div id="card-body-ai" class="space-y-3 pt-2 border-t border-base-200">
                <!-- Side-by-Side Copy Buttons -->
                <div class="grid grid-cols-2 gap-2 pt-1">
                  <!-- Button 1: Copy Full Dataset -->
                  <button
                    type="button"
                    id="copy-all-results-btn-sidebar"
                    class="btn btn-sm btn-outline btn-primary font-bold gap-1 text-[11px] px-2 justify-center"
                    title={t.copyAllResultsForAI}
                  >
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="truncate">{currentLang === 'en' ? 'Full Data' : currentLang === 'id' ? 'Teks Lengkap' : 'كامل النصوص'}</span>
                  </button>

                  <!-- Button 2: Copy Page URL -->
                  <button
                    type="button"
                    id="copy-page-url-btn"
                    class="btn btn-sm btn-primary font-bold gap-1 text-[11px] px-2 justify-center"
                    title={t.copyPageUrlForAI}
                  >
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                    <span class="truncate">{currentLang === 'en' ? 'Page URL' : currentLang === 'id' ? 'Tautan URL' : 'رابط الصفحة'}</span>
                  </button>
                </div>
              </div>
            </div>
          )}

          <!-- ======================================================== -->
          <!-- 4. READING & DISPLAY CONTROLS CARD (Self-Collapsible)    -->
          <!-- ======================================================== -->
          <div id="sidebar-controls-section">
            <SearchControls client:load lang={currentLang} />
          </div>

        </div>
      </aside>

    </div>
  </div>

  <!-- Client Script for Smooth Scrolling, Copy Buttons, and Collapsible Sidebar Persistence -->
  <script define:vars={{ allResultsAIPrompt, copiedText: t.copied, hasActiveFilters }}>
    // 1. Sidebar Card Collapse Manager with localStorage persistence
    const STORAGE_KEY = 'openbayan_sidebar_cards_state';
    
    function getCardStates() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) return JSON.parse(saved);
      } catch (e) {}
      // Default: facets closed (unless active filters present), thematic open, ai open
      return {
        facets: hasActiveFilters ? true : false,
        thematic: true,
        ai: true
      };
    }

    function saveCardState(cardKey, isOpen) {
      try {
        const current = getCardStates();
        current[cardKey] = isOpen;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(current));
      } catch (e) {}
    }

    function initCollapsibleCards() {
      const states = getCardStates();
      // If user has active filters on current search, ensure facets is visible
      if (hasActiveFilters) states.facets = true;

      ['facets', 'thematic', 'ai'].forEach(key => {
        const body = document.getElementById(`card-body-${key}`);
        const btn = document.querySelector(`[data-toggle-collapse="${key}"]`);
        const chevron = btn ? btn.querySelector('.chevron-icon') : null;
        
        if (body && btn) {
          const isOpen = states[key] !== undefined ? states[key] : (key !== 'facets');
          
          if (isOpen) {
            body.classList.remove('hidden');
            if (chevron) chevron.classList.add('rotate-180');
          } else {
            body.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
          }

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const nowHidden = body.classList.toggle('hidden');
            const nowOpen = !nowHidden;
            if (chevron) {
              if (nowOpen) chevron.classList.add('rotate-180');
              else chevron.classList.remove('rotate-180');
            }
            saveCardState(key, nowOpen);
          });
        }
      });
    }

    // Initialize collapses
    initCollapsibleCards();

    // 2. Smooth Scroll for Thematic Navigation Anchors
    document.querySelectorAll('[data-smooth-scroll]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const href = anchor.getAttribute('href');
        if (!href) return;
        const targetId = href.replace('#', '');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', '#' + targetId);
        }
      });
    });

    function showGlobalToast(msg) {
      const toastEl = document.getElementById('global-toast');
      const toastText = document.getElementById('global-toast-text');
      if (toastEl && toastText) {
        toastText.textContent = msg;
        toastEl.classList.remove('hidden');
        setTimeout(() => toastEl.classList.add('hidden'), 3000);
      }
    }

    // 3. Copy Full Corpus Results
    const copyAllSidebarBtn = document.getElementById('copy-all-results-btn-sidebar');
    if (copyAllSidebarBtn) {
      copyAllSidebarBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(allResultsAIPrompt);
        showGlobalToast(copiedText);
      });
    }

    // 4. Copy Page URL
    const pageUrlBtn = document.getElementById('copy-page-url-btn');
    if (pageUrlBtn) {
      pageUrlBtn.addEventListener('click', () => {
        const queryUrl = window.location.href;
        const prompt = `Please analyze and synthesize the classical Islamic corpus search results available at this live URL:\n${queryUrl}\n\nTask: Explore the primary source passages on this page, evaluate the key definitions and rulings, and summarize the consensus across Sunni schools.`;
        navigator.clipboard.writeText(prompt);
        showGlobalToast(copiedText);
      });
    }
  </script>
</BaseLayout>
