---
import { LanguageSwitcher } from '../islands/LanguageSwitcher';
import { translations, getLangFromUrl, type SupportedLanguage } from '../../lib/i18n';

interface Props {
  lang?: SupportedLanguage;
}

const urlLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || urlLang;
const t = translations[currentLang];
---

<header class="sticky top-0 z-30 bg-base-100/90 backdrop-blur border-b border-base-200/80 transition-all">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={`/?lang=${currentLang}`} class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-700 to-teal-600 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
        <span class="font-serif text-2xl font-bold">ب</span>
      </div>
      <div>
        <span class="font-bold text-lg tracking-tight font-sans block leading-none text-base-content">{t.appName}</span>
        <span class="text-xs text-base-content/60 font-sans tracking-wide">{t.appSubtitle}</span>
      </div>
    </a>

    <!-- Navigation / Quick Links & Language Switcher -->
    <nav class="flex items-center gap-2">
      <a href={`/search?q=صحيح+البخاري&lang=${currentLang}`} class="btn btn-ghost btn-xs sm:btn-sm text-base-content/80 font-sans hidden sm:inline-flex">صحيح البخاري</a>
      <a href={`/search?q=شرح+المجموع&lang=${currentLang}`} class="btn btn-ghost btn-xs sm:btn-sm text-base-content/80 font-sans hidden sm:inline-flex">المجموع</a>

      <!-- Language Switcher Island -->
      <LanguageSwitcher client:load currentLang={currentLang} />

      <div class="divider divider-horizontal my-3 mx-0.5"></div>

      <!-- GitHub Link -->
      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-ghost btn-circle btn-sm text-base-content/70"
        title="GitHub Repository"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </nav>
  </div>
</header>
