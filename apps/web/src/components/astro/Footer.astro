---
import { translations, getLangFromUrl, type SupportedLanguage } from '../../lib/i18n';

interface Props {
  lang?: SupportedLanguage;
}

const urlLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || urlLang;
const t = translations[currentLang];
---

<footer class="mt-20 border-t border-base-200/90 bg-base-100/70 font-sans text-xs text-base-content/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-12 gap-8">

    <!-- Column 1: Brand & Platform Mission (5 cols) -->
    <div class="md:col-span-5 space-y-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-800 text-white flex items-center justify-center font-serif font-bold text-base shadow-sm">
          ب
        </div>
        <span class="font-bold text-base text-base-content">
          {t.appName} — {t.appSubtitle}
        </span>
      </div>
      <p class="text-base-content/60 leading-relaxed text-xs max-w-sm">
        {t.footerMission}
      </p>
      <div class="flex items-center gap-3 pt-2 text-[11px] text-base-content/50 font-mono">
        <span>SQLite FTS5</span>
        <span>•</span>
        <span>ONNX Multilingual E5</span>
        <span>•</span>
        <span>RRF k=60</span>
      </div>
    </div>

    <!-- Column 2: Digital Libraries (3 cols) -->
    <div class="md:col-span-3 space-y-2.5">
      <h4 class="font-bold text-base-content text-xs uppercase tracking-wider">
        {t.digitalLibrariesTitle}
      </h4>
      <ul class="space-y-2 text-xs text-base-content/70">
        <li>
          <a 
            href="https://turath.io" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Turath.io (تراث)</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li>
          <a 
            href="https://shamela.ws" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Al-Maktaba Al-Shamela (الشاملة)</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li>
          <a 
            href="https://quran.ksu.edu.sa" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>KSU Ayah & Tafsir Engine</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 3: Academic AI Grounding & API (4 cols) -->
    <div class="md:col-span-4 space-y-2.5">
      <h4 class="font-bold text-base-content text-xs uppercase tracking-wider">
        {t.openApiTitle}
      </h4>
      <p class="text-base-content/60 text-[11px] leading-relaxed">
        {t.openApiDesc}
      </p>
      <div class="bg-base-200/50 border border-base-300/60 p-2.5 rounded-xl text-[11px] font-mono text-emerald-800 dark:text-emerald-400 flex items-center justify-between">
        <span>GET /p/:chunk_id</span>
        <span class="badge badge-xs badge-success">200 OK</span>
      </div>
    </div>

  </div>

  <!-- Bottom Bar with Live Sync Pulse -->
  <div class="bg-base-200/40 border-t border-base-200 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-base-content/60">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{t.footerStats}</span>
      </div>
      <div>
        {t.footerBottomTag}
      </div>
    </div>
  </div>
</footer>
