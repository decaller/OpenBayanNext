---
import { translations, getLangFromUrl, type SupportedLanguage } from '../../lib/i18n';
import { INTERNAL_API_URL, type TelemetryStats } from '../../lib/api';

interface Props {
  lang?: SupportedLanguage;
}

const urlLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || urlLang;
const t = translations[currentLang];

let telemetry: TelemetryStats = {
  page_visits: 1420,
  total_queries: 482,
  avg_latency_ms: 36.4,
  total_books: 60,
  total_chunks: 76274,
  total_sections: 97533,
  uptime_seconds: 3600,
  recent_queries: []
};

try {
  const res = await fetch(`${INTERNAL_API_URL}/telemetry/stats`);
  if (res.ok) {
    telemetry = await res.json();
  }
} catch (e) {}
---

<footer class="mt-20 border-t border-base-200/90 bg-base-100/70 font-sans text-xs text-base-content/70">
  
  <!-- Live Analytics Stats Banner (Milestone 3.5 Telemetry) -->
  <div class="border-b border-base-200/80 bg-base-200/40 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        
        <!-- Metric 1: Total Page Visits -->
        <div class="bg-base-100/90 p-4 rounded-2xl border border-base-200 shadow-xs flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-lg flex-shrink-0">
            👁️
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-base-content/60 font-semibold">{t.pageVisitsTitle}</span>
            <span class="text-base sm:text-lg font-bold font-mono text-base-content" id="telemetry-visits">
              {telemetry.page_visits.toLocaleString()}
            </span>
          </div>
        </div>

        <!-- Metric 2: Total Searches Executed -->
        <div class="bg-base-100/90 p-4 rounded-2xl border border-base-200 shadow-xs flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-800/10 text-emerald-800 dark:text-emerald-400 flex items-center justify-center text-lg flex-shrink-0">
            🔍
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-base-content/60 font-semibold">{t.searchesExecuted}</span>
            <span class="text-base sm:text-lg font-bold font-mono text-base-content" id="telemetry-queries">
              {telemetry.total_queries.toLocaleString()}
            </span>
          </div>
        </div>

        <!-- Metric 3: Average Query Latency -->
        <div class="bg-base-100/90 p-4 rounded-2xl border border-base-200 shadow-xs flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-800/10 text-teal-800 dark:text-teal-400 flex items-center justify-center text-lg flex-shrink-0">
            ⚡
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-base-content/60 font-semibold">{t.avgSearchLatency}</span>
            <span class="text-base sm:text-lg font-bold font-mono text-emerald-700 dark:text-emerald-400" id="telemetry-latency">
              {telemetry.avg_latency_ms} ms
            </span>
          </div>
        </div>

        <!-- Metric 4: Verified Scholarly Corpus Volume -->
        <div class="bg-base-100/90 p-4 rounded-2xl border border-base-200 shadow-xs flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-800/10 text-amber-800 dark:text-amber-400 flex items-center justify-center text-lg flex-shrink-0">
            📚
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-base-content/60 font-semibold">
              {currentLang === 'en' ? 'Indexed Chunks' : currentLang === 'id' ? 'Kutipan Terindeks' : 'المواضع المفهرسة'}
            </span>
            <span class="text-base sm:text-lg font-bold font-mono text-base-content">
              {telemetry.total_chunks.toLocaleString()}
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Main Footer Content Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-12 gap-8">

    <!-- Column 1: Brand & Platform Mission (5 cols) -->
    <div class="md:col-span-5 space-y-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-800 text-white flex items-center justify-center font-serif font-bold text-base shadow-sm">
          ب
        </div>
        <span class="font-bold text-base text-base-content">
          {t.appName} — {t.appSubtitle}
        </span>
      </div>
      <p class="text-base-content/60 leading-relaxed text-xs max-w-sm">
        {t.footerMission}
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
        <a 
          href={`/about?lang=${currentLang}`}
          class="hover:text-primary transition-colors font-semibold inline-flex items-center gap-1 text-base-content/80 hover:underline"
        >
          <span>ℹ️</span>
          <span>{t.aboutNav}</span>
        </a>
        <span class="text-base-content/30">•</span>
        <a 
          href="https://github.com/decaller/OpenBayanNext" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors font-semibold inline-flex items-center gap-1 text-base-content/80 hover:underline"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>
        <span class="text-base-content/30">•</span>
        <a 
          href="https://wa.me/628111729896" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-success transition-colors font-semibold inline-flex items-center gap-1 text-base-content/80 hover:underline"
          title="WhatsApp: Harridi Ilman Tovid (+628111729896)"
        >
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">💬</span>
          <span>WA: +628111729896</span>
        </a>
      </div>
      <div class="flex items-center gap-3 pt-1 text-[11px] text-base-content/50 font-mono">
        <span>SQLite FTS5</span>
        <span>•</span>
        <span>ONNX Multilingual E5</span>
        <span>•</span>
        <span>RRF k=60</span>
      </div>
    </div>

    <!-- Column 2: Digital Libraries (3 cols) -->
    <div class="md:col-span-3 space-y-2.5">
      <h4 class="font-bold text-base-content text-xs uppercase tracking-wider">
        {t.digitalLibrariesTitle}
      </h4>
      <ul class="space-y-2 text-xs text-base-content/70">
        <li>
          <a 
            href="https://turath.io" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Turath.io (تراث)</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li>
          <a 
            href="https://shamela.ws" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Al-Maktaba Al-Shamela (الشاملة)</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
        <li>
          <a 
            href="https://quran.ksu.edu.sa" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
          >
            <span>KSU Ayah & Tafsir Engine</span>
            <svg class="w-3 h-3 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 3: Academic AI Grounding & API (4 cols) -->
    <div class="md:col-span-4 space-y-2.5">
      <h4 class="font-bold text-base-content text-xs uppercase tracking-wider">
        {t.openApiTitle}
      </h4>
      <p class="text-base-content/60 text-[11px] leading-relaxed">
        {t.openApiDesc}
      </p>
      <div class="bg-base-200/50 border border-base-300/60 p-2.5 rounded-xl text-[11px] font-mono text-emerald-800 dark:text-emerald-400 flex items-center justify-between">
        <span>GET /api/v1/telemetry/stats</span>
        <span class="badge badge-xs badge-success">Live 200 OK</span>
      </div>
    </div>

  </div>

  <!-- Bottom Bar with Live Sync Pulse -->
  <div class="bg-base-200/40 border-t border-base-200 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-base-content/60">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{telemetry.total_books} {t.footerStats.split('•')[0].trim()} • {telemetry.total_sections.toLocaleString()} {t.sectionsCount} • {telemetry.total_chunks.toLocaleString()} {t.passages}</span>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href={`/about?lang=${currentLang}`} class="hover:text-primary hover:underline transition-colors">{t.aboutNav}</a>
        <span>•</span>
        <a href="https://github.com/decaller/OpenBayanNext" target="_blank" rel="noopener noreferrer" class="hover:text-primary hover:underline transition-colors">GitHub</a>
        <span>•</span>
        <a href="https://wa.me/628111729896" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 hover:underline transition-colors">WhatsApp: Harridi Ilman Tovid (+628111729896)</a>
        <span>•</span>
        <span>{t.footerBottomTag}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Record page visit asynchronously
  if (typeof window !== 'undefined') {
    try {
      fetch('/api/v1/telemetry/visit', { method: 'POST' }).catch(() => {});
    } catch(e) {}
  }
</script>
