---
import type { SearchResultItem } from '../../lib/api';

interface Props {
  chunk: SearchResultItem;
  rankIndex?: number;
}

const { chunk, rankIndex } = Astro.props;

// Format snippet with highlighted tags
const formattedSnippet = chunk.text_snippet
  .replace(/<span data-type=['"]title['"].*?>.*?<\/span>/g, '')
  .trim();
---

<article 
  class="card bg-base-100 border border-base-200/90 hover:border-emerald-700/30 hover:shadow-md transition-all duration-200 rounded-2xl overflow-hidden mb-4"
  id={`chunk-${chunk.chunk_id}`}
>
  <div class="card-body p-5 sm:p-6">
    <!-- Top Metadata Bar -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-sans pb-3 border-b border-base-200/60">
      <div class="flex items-center gap-2">
        {rankIndex !== undefined && (
          <span class="badge badge-sm badge-neutral font-mono font-bold text-xs">
            #{rankIndex}
          </span>
        )}
        <span class="font-bold text-sm text-emerald-800 dark:text-emerald-400">
          {chunk.book_name}
        </span>
        <span class="badge badge-sm badge-ghost font-mono">
          {chunk.volume_page}
        </span>
        {chunk.is_merged && (
          <span class="badge badge-xs badge-success badge-outline">
            صفحتان متتاليتان
          </span>
        )}
      </div>

      <!-- Relevance / RRF Tag -->
      <div class="text-base-content/50 text-[11px] font-mono">
        RRF: {chunk.rrf_score.toFixed(4)}
      </div>
    </div>

    <!-- Breadcrumb Hierarchy -->
    <div class="text-xs font-sans text-base-content/65 flex items-center gap-1.5 my-1 overflow-hidden text-ellipsis whitespace-nowrap">
      <svg class="w-3.5 h-3.5 flex-shrink-0 text-emerald-700/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
      </svg>
      <span>{chunk.breadcrumb}</span>
    </div>

    <!-- Main Classical Text (Amiri Font) -->
    <div class="arabic-matn text-base sm:text-lg text-base-content/90 my-2 leading-loose">
      {formattedSnippet}
    </div>

    <!-- Footnotes Preview if present -->
    {chunk.footnotes && (
      <div class="mt-2 pt-2 border-t border-dashed border-base-200 text-xs font-sans text-base-content/60 leading-relaxed bg-base-200/20 rounded-lg p-2.5">
        <span class="font-bold text-base-content/70">حاشية: </span>
        <span>{chunk.footnotes.slice(0, 160)}...</span>
      </div>
    )}

    <!-- Bottom Actions Bar (0 KB JS Bridge to Nanostores & Permalinks) -->
    <div class="flex items-center justify-between pt-3 mt-1 border-t border-base-200/60 font-sans">
      <!-- 0-JS Permalink Link -->
      <a 
        href={`/p/${chunk.chunk_id}`} 
        class="btn btn-ghost btn-xs text-base-content/70 hover:text-emerald-700 gap-1"
        title="رابط دائم للصفحة والمحيط الكامل"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span>رابط المقتطف</span>
      </a>

      <!-- Level-3 Full Chapter Drawer Trigger (Static HTML Data Attribute) -->
      <button 
        type="button"
        class="btn btn-sm btn-outline btn-success hover:!bg-emerald-800 hover:!text-white gap-1.5 font-bold"
        data-open-drawer
        data-book-id={chunk.book_id}
        data-section-id={chunk.section_id}
        data-section-title={chunk.section_title}
        data-breadcrumb={chunk.breadcrumb}
        data-chunk-id={chunk.chunk_id}
      >
        <span>مطالعة الباب كاملاً</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>
</article>
